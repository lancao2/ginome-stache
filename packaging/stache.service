[Unit]
Description=Stache (ilha dinâmica)
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/stache
# Sem tela ainda (o shell não subiu), o app sai com erro e é tentado de novo a cada segundo.
# "Sair" no Stache encerra com sucesso e o serviço não volta.
Restart=on-failure
RestartSec=1
StartLimitIntervalSec=0

[Install]
WantedBy=gnome-session-pre.target
